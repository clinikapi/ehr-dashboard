# ClinikAPI credentials — https://dashboard.clinikapi.com → API Keys
# Use a TEST key (clk_test_...) while developing: test traffic hits the
# sandbox datastore and is free on every plan.
CLINIKAPI_KEY=clk_test_your_key_here

# Optional — defaults to https://api.clinikapi.com
# CLINIKAPI_BASE_URL=https://api.clinikapi.com
